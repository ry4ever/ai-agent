{
  "name": "agent-services-platform",
  "version": "1.1.0",
  "description": "MCP server exposing AI agent services — research, contract analysis, code review & data enrichment — with x402 micropayments on Base L2",
  "license": "MIT",
  "author": "ry4ever <ry4ever@users.noreply.github.com>",
  "homepage": "https://agents.aiscale.pro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ry4ever/ai-agent.git"
  },
  "bugs": {
    "url": "https://github.com/ry4ever/ai-agent/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "agents",
    "x402",
    "base",
    "usdc",
    "micropayments",
    "claude",
    "cursor",
    "contract-analysis",
    "code-review"
  ],
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "bin": {
    "aiscale-mcp": "dist/mcp/server.js",
    "aiscale-pay": "dist/scripts/pay.js"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "dev:watch": "ts-node-dev --respawn --transpile-only src/index.ts",
    "db:migrate": "ts-node src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "ts-node src/scripts/seed-transactions.ts",
    "is-listed": "ts-node src/scripts/is-listed.ts",
    "mcp": "ts-node src/mcp/server.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@coinbase/cdp-sdk": "^1.45.0",
    "@coinbase/x402": "^2.1.0",
    "@modelcontextprotocol/sdk": "^1.10.0",
    "@x402/core": "^2.7.0",
    "@x402/evm": "^2.7.0",
    "@x402/express": "^2.7.0",
    "@x402/extensions": "^2.7.0",
    "@x402/fetch": "^2.17.0",
    "axios": "^1.7.0",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "ethers": "^6.13.0",
    "express": "^4.19.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.0",
    "rate-limiter-flexible": "^5.0.0",
    "uuid": "^10.0.0",
    "winston": "^3.14.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
