# =============================================================================
# Contra Jobs — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# Server
PORT=3000
NODE_ENV=development

# -----------------------------------------------------------------------------
# Contra.com Pro Account Credentials
# Sign up at https://contra.com — Pro subscription required for unlimited apps
# -----------------------------------------------------------------------------
CONTRA_EMAIL=your_email@example.com
CONTRA_PASSWORD=your_contra_password
CONTRA_SESSION_FILE=./contra-session.json  # browser session cache (auto-created)

# -----------------------------------------------------------------------------
# GLM-5 API (Zhipu AI)
# Create API key at: https://open.bigmodel.cn/usercenter/apikeys
# -----------------------------------------------------------------------------
GLM5_API_KEY=your_zhipuai_api_key
GLM5_MODEL=glm-4                                       # options: glm-4, glm-4-plus, glm-4-flash
GLM5_API_BASE=https://open.bigmodel.cn/api/paas/v4    # API base URL

# -----------------------------------------------------------------------------
# Your Freelancer Profile
# Used for cover letter generation and job fit scoring
# -----------------------------------------------------------------------------
USER_NAME=Your Full Name
USER_SKILLS=TypeScript,Python,Node.js,AI/ML,React      # comma-separated
USER_BIO=Experienced software engineer specializing in AI-powered web applications and automation.
USER_HOURLY_RATE=150                                    # desired hourly rate in USD
USER_PORTFOLIO_URL=https://your-portfolio.com           # optional

# -----------------------------------------------------------------------------
# Job Search Preferences (for autonomous / auto-apply mode)
# -----------------------------------------------------------------------------
JOB_SEARCH_KEYWORDS=TypeScript AI machine learning     # space-separated
JOB_MIN_BUDGET=500                                     # minimum job budget in USD
JOB_MAX_APPLICATIONS_PER_RUN=5                         # safety cap per run
