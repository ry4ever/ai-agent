# Coinbase Developer Platform (CDP) - https://portal.cdp.coinbase.com/
# Create API keys at: https://portal.cdp.coinbase.com/projects/api-keys
# Generate wallet secret at: https://portal.cdp.coinbase.com/products/server-wallet/accounts
CDP_API_KEY_ID=your_cdp_api_key_id
CDP_API_KEY_SECRET=your_cdp_api_key_secret
CDP_WALLET_SECRET=your_cdp_wallet_secret

# Receiving wallet address (Base L2)
WALLET_ADDRESS=0xYourReceivingWalletAddress

# Network: 'base-sepolia' for testnet, 'base-mainnet' for production
NETWORK=base-sepolia

# RPC endpoints
BASE_RPC_URL=https://sepolia.base.org
# BASE_RPC_URL=https://mainnet.base.org  # uncomment for mainnet

# USDC contract addresses
# Testnet (Base Sepolia): 0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Mainnet (Base): 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
USDC_CONTRACT=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# x402 facilitator URL
X402_FACILITATOR_URL=https://x402.org/facilitator

# Claude API (Anthropic) - https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key

# External data APIs (free tiers)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key       # https://www.alphavantage.co/support/#api-key
NEWS_API_KEY=your_news_api_key                      # https://newsapi.org/register
HUNTER_API_KEY=your_hunter_io_key                  # https://hunter.io/api-keys
CLEARBIT_API_KEY=your_clearbit_key                 # https://clearbit.com/keys

# Database
DATABASE_URL=postgresql://agentuser:agentpass@localhost:5432/agentservices
REDIS_URL=redis://localhost:6379

# Server
PORT=3000
NODE_ENV=development

# Service provider branding
PROVIDER_NAME=AgentServices
PROVIDER_URL=https://your-domain.com

# MCP (Model Context Protocol) server — optional
# Set MCP_PAYMENT_HEADER if MCP clients should include payment headers
MCP_PAYMENT_HEADER=            # base64-encoded x402 payment proof (optional)
MCP_AGENT_ADDRESS=             # wallet address of the MCP agent caller (optional)
PLATFORM_URL=http://localhost:3000  # base URL the MCP server calls for API requests
